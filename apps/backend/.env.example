# Backend environment variables. Copy to .env and fill in.

NODE_ENV=
PORT=

# Database
DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# AI provider (only consumed by src/modules/ai/ai.service.ts)
GEMINI_API_KEY=

# CORS — one origin, or a comma-separated list (e.g. a prod domain plus a
# preview-deployment URL)
CORS_ORIGIN=
